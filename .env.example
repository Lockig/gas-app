# Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler" (cổng 6543)
# postgresql://postgres.<project-ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Chỉ cần khi dùng Supabase Auth/Data API (chưa dùng ở giai đoạn này)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
# Nguồn giá xăng (mặc định: vietfuelapi demo, chỉ có giá mới nhất)
FUEL_PRICE_API_URL=https://vietfuelapi-demo.pages.dev/mock-data/fuel-prices.json
FUEL_PRICE_REGION=region1
FUEL_PRICE_API_KEY=
